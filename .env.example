# Copy to .env and replace every CHANGE_ME value.
HTTP_PORT=80
APP_UID=1000
APP_GID=1000
MYSQL_DATABASE=heritage_db
MYSQL_USER=heritage_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
BASIC_AUTH_PASSWORD=CHANGE_ME_BASIC_AUTH_PASSWORD
KNIFE4J_PASSWORD=CHANGE_ME_KNIFE4J_PASSWORD
ADMIN_BOOTSTRAP_USERNAME=site_admin
ADMIN_BOOTSTRAP_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_AT_LEAST_12_CHARS
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
DEEPSEEK_API_KEY=
MAX_UPLOAD_SIZE=100MB
MAX_UPLOAD_BYTES=104857600
# Docker deploy applies the idempotent Copper Man schema and seed data on startup.
SQL_INIT_MODE=always
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
SWAGGER_ENABLED=false
KNIFE4J_ENABLED=false
NEO4J_ENABLED=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
JAVA_OPTS="-Xms256m -Xmx1024m -Dfile.encoding=UTF-8"
